<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The app talks to an HTTPS API for literally everything: OTP, login,
         registration, profile, catalogue, quiz. Without this it does nothing.

         It MUST live in `main`, not in a per-build-type source set. Flutter
         creates `src/debug/AndroidManifest.xml` and `src/profile/` carrying this
         permission for the tool's own hot-reload channel, and those two are
         merged ONLY into their own build types. `src/main` is the one source set
         that merges into every build type, release included.

         This was Tier-0 finding C-1: the permission existed in debug and profile
         only, so every network call would have failed in a release build while
         working perfectly throughout development. No plugin supplies it — it was
         verified absent from the merged release manifest. `flutter analyze` and
         a green test suite cannot see this class of defect; only a release
         build can. See .ai/audits/current/remediation-tier0.md and the
         `release-manifest` job in .github/workflows/ci.yml, which now fails the
         build if this line is ever removed again. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Backup is disabled on purpose. This app holds minors' PII (date of birth,
         school, governorate) and auth material. allowBackup=false stops Google
         auto-backup to the user's Drive; on Android 12+ that flag does NOT cover
         device-to-device transfer, which is why dataExtractionRules is also set.
         fullBackupContent=false covers pre-12 devices.

         The label is NOT a literal: `app_name` is generated per product flavor in
         android/app/build.gradle.kts ("Level Up" / "Level Up STG", D-021 Q3), so
         the two installable identities are told apart on the launcher. -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
