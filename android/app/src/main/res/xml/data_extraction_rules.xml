<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup/transfer policy. Referenced from
  AndroidManifest.xml via android:dataExtractionRules.

  Everything is excluded from both channels:
    - cloud-backup    — Google auto-backup to the user's Drive account
    - device-transfer — device-to-device migration when setting up a new phone

  android:allowBackup="false" alone only covers cloud-backup on Android 12+;
  device-transfer keeps working unless it is excluded here. This app stores
  minors' PII and auth material, so neither channel should carry app data off
  the device.

  Keychain/KeyStore-held secrets were never included in backups, but the rest of
  the sandbox (shared prefs, databases, files) would have been.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
