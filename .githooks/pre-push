#!/bin/sh
# Level Up — pre-push hook.
#
# ENABLE (once, per clone):
#     git config core.hooksPath .githooks
# SKIP ONE PUSH:
#     git push --no-verify          (or:  LEVELUP_SKIP_HOOKS=1 git push ...)
#
# Contract: pre-commit is the fast gate, this is the honest one. It runs the
# test suite, because a green suite is the whole claim this repo makes about
# itself and CI finding out 4 minutes after the push is 4 minutes too late.
#
# It does NOT run: build_runner (generated output is committed), a release
# build (that is CI's `main`-only job), or `flutter analyze` over the whole
# tree (pre-commit already covered what you changed).
#
# Cost control: if the push carries no change under lib/ or test/, the suite is
# skipped entirely — docs-only and contract-only pushes cost nothing.
#
# Windows: runs under Git for Windows' bundled `sh`. No chmod / .sh needed.

set -eu

[ "${LEVELUP_SKIP_HOOKS:-0}" = "1" ] && exit 0

root="$(git rev-parse --show-toplevel)"
cd "$root"

zero='0000000000000000000000000000000000000000'

# git feeds pre-push one line per ref on stdin:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# Collect every file touched across all pushed refs. If we cannot work out a
# range (new branch, unknown remote sha), fall back to running the suite —
# never to skipping it.
touched=''
run_anyway=0
saw_ref=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  saw_ref=1

  # Branch deletion — nothing to test.
  case "$local_sha" in "$zero"|"$zero"*) continue ;; esac

  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    run_anyway=1
    continue
  fi

  files="$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || echo '')"
  if [ -z "$files" ] && [ "$remote_sha" != "$local_sha" ]; then
    run_anyway=1
  fi
  touched="$touched
$files"
done

# Invoked outside a real push (manual run, or an empty stdin) — be conservative.
[ "$saw_ref" -eq 0 ] && run_anyway=1

if [ "$run_anyway" -eq 0 ]; then
  if ! printf '%s\n' "$touched" | grep -q -E '^(lib|test)/|^pubspec\.(yaml|lock)$|^l10n\.yaml$|^analysis_options\.yaml$'; then
    echo "pre-push: no Dart/config changes in this push — skipping tests."
    exit 0
  fi
fi

echo "pre-push: flutter test (730 cases; ~2-4 min). Ctrl-C or --no-verify to skip."

# Goldens ARE included here on purpose. They were generated on this machine, so
# unlike CI's Linux runner they are expected to pass locally — this is the only
# place the golden baselines get a blocking check before they reach a reviewer.
if ! flutter test --no-pub --reporter compact; then
  echo ""
  echo "pre-push FAILED — the suite is red."
  echo "  Full detail:  tool/validate.ps1   (or tool/validate.sh)"
  echo "  Bypass:       git push --no-verify"
  exit 1
fi

echo "pre-push: ok"
exit 0
