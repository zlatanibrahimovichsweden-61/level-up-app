# Normalize line endings: store LF in the repo, auto on checkout.
* text=auto eol=lf

# Windows-only scripts must stay CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Unix scripts / Gradle wrapper must stay LF
*.sh      text eol=lf
gradlew   text eol=lf

# Binary assets — never convert
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.jar   binary
*.keystore binary
*.pdf   binary
